debug_*.mp4

# ============ 原始考核素材 ============
# 体积大且评委手里已有，不入库；README 中说明素材来源
data/

# ============ 超大中间产物 ============
# 注意：需要交付的结果视频 / GIF 仍然要入库
qA_aim/figures/**/*.raw.mp4
qA_aim/figures/**/frames/

# ============ 题二手机原图 ============
# 12MP 原图单张 3~5MB，20 张上百 MB，不入库。
# 转正缩小后的副本放在 q2_calib/calib_images/，那份入库。
q2_calib/phone_raw/*
!q2_calib/phone_raw/.gitkeep

# ============ 测距废图 ============
# 背景对比度不足、未检出的废图，不入库
q2_calib/measure_images/_failed/

